rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 노래연습 MR 파일 (works 노래연습 탭) — 대표님만 올리고 읽음. 재생은 다운로드 URL(토큰 포함)로 받는다.
    match /songs/{songId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.token.email in ['kj0010735@gmail.com'];
    }
    match /hero/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email in ['kj0010735@gmail.com'];
    }
  }
}
