#!/bin/bash
R=$(osascript -l JavaScript -e 'ObjC.import("AppKit"); var a=$.NSRunningApplication.runningApplicationsWithBundleIdentifier("com.google.Chrome.app.kifhpkmeipjeilnbklflmfejdalnbgih"); if (Number(a.count) === 0) { "open" } else { var app=a.objectAtIndex(0); if (app.active) { app.hide; "hidden" } else { "open" } }')
# Chrome 앱 이름이 바뀌면(예: 작업관리 → WORKS) 앱 파일 이름도 바뀌므로 경로 대신 번들 id로 연다
[ "$R" = "open" ] && { open -b "com.google.Chrome.app.kifhpkmeipjeilnbklflmfejdalnbgih" 2>/dev/null || open "/Users/user/Applications/Chrome Apps.localized/WORKS.app"; }
exit 0
