rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.token.email in ['kj0010735@gmail.com'];
    }

    // 게스트(?guest=1)는 로그인 없이 접속하는 공동작업자. 공유 프로젝트는
    // 같이 등록/수정 가능하지만, 장비목록은 보기만 가능하고 수정은 owner만.
    match /equipment/{id} { allow read: if true; allow write: if isOwner(); }
    match /categories/{id} { allow read: if true; allow write: if isOwner(); }
    match /sharedProjects/{id} { allow read, write: if true; }
    // 홈페이지 콘텐츠는 게스트와 무관 — admin 로그인한 사람만 수정.
    match /siteContent/{id} { allow read: if true; allow write: if isOwner(); }

    // 내부 전용 — guest 모드에서도 노출되지 않는 데이터.
    match /schedule/{id} { allow read, write: if isOwner(); }
    match /projects/{id} { allow read, write: if isOwner(); }
    match /shoots/{id} { allow read, write: if isOwner(); }
    match /presets/{id} { allow read, write: if isOwner(); }
    match /todayTasks/{id} { allow read, write: if isOwner(); }
    match /notes/{id} { allow read, write: if isOwner(); }
    match /shortcuts/{id} { allow read, write: if isOwner(); }
    // 앱 설정(예: 아이폰 구독용 Google 캘린더 비공개 iCal 주소) — 비밀 링크라 owner만.
    match /appSettings/{id} { allow read, write: if isOwner(); }

    // 견적서 — 원본은 owner만. 클라이언트에게 보내는 사본(quotesPublic/{비밀 id})은 id를 아는 사람만 단건 조회 가능(목록 조회 불가),
    // 클라이언트는 아직 승인 전인 문서의 approval 필드 하나만 채울 수 있다(금액·항목 등 다른 필드는 못 바꿈).
    match /quotes/{id} { allow read, write: if isOwner(); }
    match /quotesPublic/{id} {
      allow get: if true;
      allow list, create, delete: if isOwner();
      allow update: if isOwner() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approval'])
        && resource.data.approval == null
        && request.resource.data.approval is map
        && request.resource.data.approval.keys().hasOnly(['name', 'at'])
        && request.resource.data.approval.name is string
        && request.resource.data.approval.name.size() > 0
        && request.resource.data.approval.name.size() <= 40
        && request.resource.data.approval.at is int
      );
    }

    // 전자계약서 — 원본은 owner만. 서명용 사본(contractsPublic/{비밀 id})은 단건 조회만 공개.
    // owner는 서명 전까지만 사본을 고칠 수 있고(서명된 계약서는 owner도 못 바꿈), 클라이언트는 서명 전 문서에
    // signing 필드 하나만, 문서 내용 해시(hash)가 일치할 때만 채울 수 있다.
    match /contracts/{id} { allow read, write: if isOwner(); }
    match /contractsPublic/{id} {
      allow get: if true;
      allow list, create, delete: if isOwner();
      allow update: if (isOwner() && resource.data.signing == null) || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signing'])
        && resource.data.signing == null
        && request.resource.data.signing is map
        && request.resource.data.signing.keys().hasOnly(['name', 'signature', 'at', 'hash', 'ua'])
        && request.resource.data.signing.name is string
        && request.resource.data.signing.name.size() > 0
        && request.resource.data.signing.name.size() <= 60
        && request.resource.data.signing.signature is string
        && request.resource.data.signing.signature.size() < 400000
        && request.resource.data.signing.signature.matches('^data:image/png;base64,[A-Za-z0-9+/=]+$')
        && request.resource.data.signing.at is int
        && request.resource.data.signing.hash == resource.data.hash
        && request.resource.data.signing.ua is string
        && request.resource.data.signing.ua.size() <= 400
      );
    }

    // STUDIO FINANCE 통합장부(ledger/index.html) — 재무 데이터라 owner만 읽고 쓸 수 있다.
    match /ledgerEntries/{id} { allow read, write: if isOwner(); }
    match /ledgerSubscriptions/{id} { allow read, write: if isOwner(); }
    match /ledgerSettings/{id} { allow read, write: if isOwner(); }
  }
}
