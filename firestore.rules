rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.token.email in ['kj0010735@gmail.com'];
    }

    // 게스트(?guest=1)는 로그인 없이 접속하는 공동작업자. 공유 프로젝트는
    // 같이 등록/수정 가능하지만, 장비목록은 보기만 가능하고 수정은 owner만.
    match /equipment/{id} { allow read: if true; allow write: if isOwner(); }
    match /categories/{id} { allow read: if true; allow write: if isOwner(); }
    match /sharedProjects/{id} { allow read, write: if true; }
    // 홈페이지 콘텐츠는 게스트와 무관 — admin 로그인한 사람만 수정.
    match /siteContent/{id} { allow read: if true; allow write: if isOwner(); }

    // 내부 전용 — guest 모드에서도 노출되지 않는 데이터.
    match /schedule/{id} { allow read, write: if isOwner(); }
    match /projects/{id} { allow read, write: if isOwner(); }
    match /shoots/{id} { allow read, write: if isOwner(); }
    match /presets/{id} { allow read, write: if isOwner(); }
    match /todayTasks/{id} { allow read, write: if isOwner(); }
    match /notes/{id} { allow read, write: if isOwner(); }
    match /shortcuts/{id} { allow read, write: if isOwner(); }

    // STUDIO FINANCE 통합장부(ledger/index.html) — 재무 데이터라 owner만 읽고 쓸 수 있다.
    match /ledgerEntries/{id} { allow read, write: if isOwner(); }
    match /ledgerSubscriptions/{id} { allow read, write: if isOwner(); }
    match /ledgerSettings/{id} { allow read, write: if isOwner(); }
  }
}
