rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /equipment/{id} { allow read, write: if true; }
    match /categories/{id} { allow read, write: if true; }
    match /schedule/{id} { allow read, write: if true; }
    match /projects/{id} { allow read, write: if true; }
    match /shoots/{id} { allow read, write: if true; }
    match /presets/{id} { allow read, write: if true; }
    match /todayTasks/{id} { allow read, write: if true; }
    match /notes/{id} { allow read, write: if true; }
    match /sharedProjects/{id} { allow read, write: if true; }
    match /siteContent/{id} { allow read, write: if true; }
  }
}
